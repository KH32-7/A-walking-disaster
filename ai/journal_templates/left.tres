[gd_resource type="Resource" script_class="JournalTemplate" format=3]

[ext_resource type="Script" path="res://systems/defs/journal_template.gd" id="1_jtpl"]

[resource]
script = ExtResource("1_jtpl")
id = &"left"
lines = Array[String](["{name|이} 학교를 떠났다. 문은 열어 두었다.", "{name|이} 다른 길을 찾아 떠났다. 두고 간 물건은 잘 챙겨 두었다.", "{name|과} 헤어졌다. 언젠가 무전으로라도 소식을 듣고 싶다.", "{name|이} 떠났다. 더 머물 이유를 주지 못한 것 같아 마음에 걸린다."])
priority = 65
