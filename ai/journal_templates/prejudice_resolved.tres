[gd_resource type="Resource" script_class="JournalTemplate" format=3]

[ext_resource type="Script" path="res://systems/defs/journal_template.gd" id="1_jtpl"]

[resource]
script = ExtResource("1_jtpl")
id = &"prejudice_resolved"
lines = Array[String](["{name|이} {other}에게 먼저 말을 걸었다. 둘은 저녁 내내 이야기했다.", "{name|이} {other}에게 사과했다. {other|은} 웃으며 차를 건넸다.", "{name|과} {other|이} 처음으로 같은 식탁에 앉았다.", "{name|이} {other}의 이야기를 끝까지 들었다. 오해가 하나 풀렸다."])
priority = 80
