[gd_resource type="Resource" script_class="ResidentTemplate" format=3]

[ext_resource type="Script" path="res://systems/defs/resident_template.gd" id="1_rtpl"]

[resource]
script = ExtResource("1_rtpl")
id = &"cook_byun"
name = "변수진"
age_stage = 3
former_job = &"cook"
traits = Array[StringName]([&"diligent", &"chatty"])
likes = Array[StringName]([&"spicy_food", &"cooking"])
dislikes = Array[StringName]([&"wasted_food", &"cold"])
access_needs = Array[int]([3])
background = "백반집을 하던 40대 요리사. 당뇨가 있어 하루 두 번 인슐린을 맞아야 한다. 약국에 남은 약을 찾으러 나왔다가 마물을 피해 식당 창고에 숨었다."
fragments = Array[String](["냉장고에 남은 것만으로 열 사람 밥상을 차리는 게 특기다. 메뉴판에 없는 메뉴가 백반집의 진짜 메뉴였다.", "인슐린은 차갑게 보관해야 한다. 기지에 전기가 들어오는 날, 수진이 제일 먼저 확인하는 건 냉장고다."])
contribution = "적은 재료로 여러 사람의 끼니를 만든다."
first_line = "배고프죠? 나가면 제가 뭐라도 만들게요."
rescue_lines = Array[String](["잠깐만요, 어지러우면 바로 말할게요.", "저 가게, 조미료 남았을지도 몰라요.", "사탕 하나만요. 당 떨어질 때 먹게."])
situation = "백반집 식당 창고"
reviewed = true
