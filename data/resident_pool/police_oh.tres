[gd_resource type="Resource" script_class="ResidentTemplate" format=3]

[ext_resource type="Script" path="res://systems/defs/resident_template.gd" id="1_rtpl"]

[resource]
script = ExtResource("1_rtpl")
id = &"police_oh"
name = "오만석"
age_stage = 4
former_job = &"police"
traits = Array[StringName]([&"brave", &"big_eater"])
likes = Array[StringName]([&"newspaper", &"hot_soup"])
dislikes = Array[StringName]([&"mumbling", &"noisy_rooms"])
access_needs = Array[int]([2])
background = "파출소에서 정년퇴직한 70대 전직 경찰. 보청기 배터리가 떨어진 뒤로는 입 모양을 보고 말을 알아듣는다. 아파트 경비실을 지키며 이웃집 열쇠를 맡아 두었다."
fragments = Array[String](["순찰은 늘 같은 길로 돌지 않았다. 순서를 바꾸는 게 요령이라며 경비실 벽에 동선표를 그려 두었다.", "보청기 배터리를 찾아 주면 한동안 말이 많아진다. 대부분 옛날 파출소 이야기지만 그중 절반은 쓸모가 있다."])
contribution = "경계 순찰 동선과 교대표를 짠다."
first_line = "얼굴 보고 말해 주게. 입 모양 보면 알아들어."
rescue_lines = Array[String](["내 앞에서 말해. 뒤에선 못 들어.", "저 골목, 막다른 길이야.", "자네, 발소리가 너무 커."])
situation = "아파트 경비실"
