[gd_resource type="Resource" script_class="ResidentTemplate" format=3]

[ext_resource type="Script" path="res://systems/defs/resident_template.gd" id="1_rtpl"]

[resource]
script = ExtResource("1_rtpl")
id = &"painter_moon"
name = "문채원"
age_stage = 3
former_job = &"painter"
traits = Array[StringName]([&"quiet_step", &"diligent"])
likes = Array[StringName]([&"art_supplies", &"fruit"])
dislikes = Array[StringName]([&"dark", &"crowds"])
access_needs = Array[int]([2])
background = "골목 벽화를 그리던 농인 화가. 대피 사이렌은 들리지 않았고, 문자 경보는 통신이 끊긴 뒤에야 왔다. 작업실 창에 커다랗게 SOS를 그려 두고 구조를 기다렸다."
fragments = Array[String](["수어는 소리가 나지 않는다. 마물이 소리를 쫓는 바깥에서는 손짓 몇 개만 알아도 살아 돌아올 확률이 달라진다고, 채원은 손으로 말한다.", "물감이 떨어지면 벽돌 가루와 숯을 갈아 쓴다. 기지 벽에 무엇을 그릴지 벌써 스케치북 한 권을 채웠다."])
contribution = "수어 손짓을 가르쳐 필드에서 소리 없이 신호하게 한다."
first_line = "(스케치북에 적는다) 와 줘서 고마워요."
rescue_lines = Array[String](["(손바닥을 아래로 누른다) 조용히.", "(앞을 가리킨다) 저기 뭔가 움직여요.", "(스케치북) 어깨를 두드려 주면 돼요."])
situation = "벽화 작업실"
