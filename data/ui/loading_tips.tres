[gd_resource type="Resource" script_class="LoadingTips" format=3]

[ext_resource type="Script" path="res://ui/defs/loading_tips.gd" id="1_tips"]

[resource]
script = ExtResource("1_tips")
tips = Array[String](["비 오는 날에는 소음이 덜 퍼져요.", "안전 주머니에 넣은 것은 쓰러져도 남아요.", "동행자나 구조자를 두고 탈출하면 그 사람은 그 지역에 고립돼요.", "상자를 열면 물건이 칸마다 확인돼요. 움직이면 확인이 멈춰요.", "잃어버린 장비는 다음 출격 한 번 동안만 지도에 표시돼요.", "뛰거나 쏘면 소리가 커서 더 멀리 있는 마물까지 들어요.", "기지 습격 경보가 오면 가장 가까운 탈출 지점까지 길이 표시돼요.", "숨은 경로는 그 길을 아는 사람이 일행에 있어야 지도에 나타나요."])
