[gd_resource type="Resource" script_class="BuildingDef" format=3]

[ext_resource type="Script" path="res://base/defs/building_def.gd" id="1_unfj8"]

[resource]
script = ExtResource("1_unfj8")
id = &"radio_room"
display_name = "방송실"
description = "공터 남쪽 야영지의 방송실이에요. 주민을 두면 방송을 맡아 구조 소문을 듣고, 레벨을 올리면 먼 신호를 잡아요."
category = 8
size = Vector2i(0, 0)
capacity = 1
power_use = Array[int]([0, 2, 2])
power_priority = 2
prebuilt = true
level_cost_override = Array[Dictionary]([{}, {&"radio_parts": 5, &"scrap": 30}, {}])
note = "공터 남쪽 야영지에 처음부터 있는 방송실(지을 수 없고 철거 불가). 주민을 배치하면 방송을 맡음. 시작부터 Lv1. Lv2: 고철 30, 무전 부품 5"
