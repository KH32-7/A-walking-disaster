[gd_resource type="Resource" script_class="QuestDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/defs/quest_def.gd" id="1_qdef"]
[ext_resource type="Script" path="res://systems/defs/quest_objective.gd" id="2_qobj"]

[sub_resource type="Resource" id="Resource_bed"]
script = ExtResource("2_qobj")
id = &"build_bed"
kind = 3
text = "새로 온 사람이 쓸 침상 짓기"
target_id = &"bed"

[sub_resource type="Resource" id="Resource_hold"]
script = ExtResource("2_qobj")
id = &"hold_night"
kind = 4
text = "다음 날 밤까지 기지 지키기"
day_offset = 1

[resource]
script = ExtResource("1_qdef")
id = &"main_02_a_place_to_stay"
type = 0
title = "머물 곳"
description = "사람이 늘었다. 잠잘 자리를 마련하고, 소리를 듣고 몰려올 마물에게서 학교를 지켜야 한다."
trigger = &"quest"
trigger_params = {
"quest": &"main_01_left_behind"
}
giver_id = &"broadcaster"
objectives = Array[ExtResource("2_qobj")]([SubResource("Resource_bed"), SubResource("Resource_hold")])
rewards = {
"flags": [&"act1_complete", &"blueprint_palisade"],
"resources": {
&"plank": 5
}
}
