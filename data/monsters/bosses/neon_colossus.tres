[gd_resource type="Resource" script_class="BossDef" format=3]

[ext_resource type="Script" path="res://field/defs/boss_def.gd" id="1_boss"]
[ext_resource type="Script" path="res://field/defs/boss_pattern.gd" id="2_pattern"]
[ext_resource type="Script" path="res://field/monsters/boss/mechanics/colossus_mechanic.gd" id="3_mech"]

[sub_resource type="Resource" id="Pattern_laser"]
script = ExtResource("2_pattern")
id = &"laser"
range_min = 3.0
range_max = 18.0
cooldown_sec = 6.0
windup_sec = 1.2
shape = &"line"
anchor = 0
length = 18.0
width = 2.2
kind = &"danger"
damage_mult = 1.3
status = Array[Dictionary]([{"id": &"shock"}])

[sub_resource type="Resource" id="Pattern_shock_floor"]
script = ExtResource("2_pattern")
id = &"shock_floor"
action = &"shock_floor"
range_min = 0.0
range_max = 14.0
cooldown_sec = 9.0
windup_sec = 1.0
shape = &"circle"
anchor = 2
radius = 2.5
kind = &"danger"
damage_mult = 0.6
status = Array[Dictionary]([{"id": &"shock"}])
params = {
"count": 3,
"spread": 4.0,
"zone_sec": 4.0
}

[sub_resource type="Resource" id="Pattern_summon_moths"]
script = ExtResource("2_pattern")
id = &"summon_moths"
range_min = 0.0
range_max = 18.0
cooldown_sec = 18.0
windup_sec = 1.0
shape = &""
summon_id = &"neon_moth"
summon_count = 2
summon_max_alive = 4
summon_dist_min = 4.0
summon_dist_max = 8.0

[resource]
script = ExtResource("1_boss")
monster_id = &"neon_colossus"
phases = Array[float]([0.5])
phase_speed = Array[float]([1.0, 1.5])
patterns = Array[ExtResource("2_pattern")]([SubResource("Pattern_laser"), SubResource("Pattern_shock_floor"), SubResource("Pattern_summon_moths")])
pattern_gap_sec = 1.0
mechanic = ExtResource("3_mech")
respawn_days = 3
first_kill_flags = Array[StringName]([&"blueprint_solar"])
first_kill_text = "네온 거신을 쓰러뜨렸다. 태양광 패널 설계도를 얻었다"
first_kill_drop_table_id = &"monster_boss_first"
