[gd_resource type="Resource" script_class="RadioTrigger" format=3]

[ext_resource type="Script" path="res://systems/defs/radio_trigger.gd" id="1_ypwb7"]

[resource]
script = ExtResource("1_ypwb7")
id = &"day_raid_return"
lines = Array[String](["기지에 낮 습격입니다. 예상은 {range}. 돌아와 주셔야겠어요.", "상황이 좋지 않습니다. {range}. 가까운 탈출 지점으로 와 주세요.", "낮 습격, 수비가 모자랍니다. {range}. 긴급 귀환을 권합니다.", "기지가 위험합니다. {range}. 지금 돌아오면 두 번째 파도부터 막을 수 있어요.", "돌아와 주세요. 예상 결과가 {range}입니다."])
cooldown_sec = 0.0
priority = 3
once_per = &"sortie"
