[gd_resource type="Resource" script_class="RadioTrigger" format=3]

[ext_resource type="Script" path="res://systems/defs/radio_trigger.gd" id="1_6yd7x"]

[resource]
script = ExtResource("1_6yd7x")
id = &"morning_greeting"
lines = Array[String](["좋은 아침입니다. 여기는 공원 숲 방송실, {day}일째 아침 방송을 시작합니다.", "{day}일째 아침이 밝았습니다. 오늘도 이 주파수 꼭 붙들고 계세요.", "방송실입니다. {day}일째네요. 커피는 없어도 방송은 있습니다.", "안녕하세요, {day}일째 아침입니다. 어젯밤도 다들 잘 버텨 주셨어요.", "여기는 방송실. {day}일째 아침 소식 전해 드립니다."])
voice_lines = Array[String](["좋은 아침입니다. 여기는 공원 숲 방송실, 아침 방송을 시작합니다.", "아침이 밝았습니다. 오늘도 이 주파수 꼭 붙들고 계세요.", "방송실입니다. 커피는 없어도 방송은 있습니다.", "안녕하세요, 좋은 아침입니다. 어젯밤도 다들 잘 버텨 주셨어요.", "여기는 방송실. 오늘 아침 소식 전해 드립니다."])
cooldown_sec = 0.0
priority = 2
guidance = false
once_per = &"day"
